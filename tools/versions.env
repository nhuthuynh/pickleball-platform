# Pinned versions of the build tools that are `go install`ed rather than
# supplied by a package manager.
#
# ONE definition, read by `make tools-install` — which is what CI calls, so
# a CI runner and a developer's machine install the same versions. Before
# this file the pins lived in the Jenkinsfile's `environment` block and
# `make tools-install` used `@latest`, which meant the local gate and the
# pipeline could disagree and an overnight upstream release could break a
# build with no commit behind it.
#
# These are the versions the gate was last proven green with (2026-10-17),
# not the newest available. Bump deliberately: change a line, run
# `make tools-install && make ci-checks`, and commit the pin with the
# evidence.
#
# Syntax is `NAME=value` with no spaces, which is valid both as a Makefile
# `include` and as a shell `. tools/versions.env`.

BUF_VERSION=v1.74.0
SQLC_VERSION=v1.31.1
GOTESTSUM_VERSION=v1.13.0
# v2.15.0, not v2.5.0: golangci-lint refuses to run against a module whose
# Go version is newer than the one golangci-lint itself was built with --
#   Error: can't load config: the Go language version (go1.25) used to build
#   golangci-lint is lower than the targeted Go version (1.26.9)
# -- and v2.5.0 is built with go1.25. The toolchain bump to 1.26.9 was forced
# by four called net/http HTTP/2 advisories. So this pin is not free-floating
# maintenance: it is the Go version's dependency.
#
# The comparison is on the LANGUAGE version — major.minor — not the patch.
# Measured 2026-10-28: raising go.mod from 1.26.9 to 1.26.10 (for
# GO-2026-6809 in crypto/x509) left this v2.15.0 binary, built with
# go1.26.9, perfectly happy. So a patch bump needs nothing here; a MINOR
# bump is what makes golangci-lint refuse to run. Check
# `golangci-lint --version`'s "built with" before raising go.mod's minor
# version, and `make tools-check` reports the installed version against
# this pin.
GOLANGCI_LINT_VERSION=v2.15.0

# The four local protoc plugins `buf generate` shells out to (ADR-0003: the
# BSR is not reachable from every environment this repo is developed in, so
# buf.gen.yaml names local plugins).
#
# These are deliberately NOT derived from go.mod. protoc-gen-go-grpc is a
# separate module from google.golang.org/grpc and versions independently
# (1.6.2 against grpc v1.83.0), and the plugin that writes the code need not
# match the library that runs it.
PROTOC_GEN_GO_VERSION=v1.36.12
PROTOC_GEN_GO_GRPC_VERSION=v1.6.2
GRPC_GATEWAY_VERSION=v2.29.0
