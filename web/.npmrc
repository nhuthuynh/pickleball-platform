# Make package.json's "engines" a hard requirement rather than a warning.
#
# npm's default is to print an EBADENGINE warning and carry on, which means
# a Node version this project does not support can install dependencies,
# build, and pass tests — on a resolution nobody has tested. The engines
# range is `^22.18.0 || >=24.12.0`; this makes npm enforce it.
#
# This is also what keeps .node-version honest. CI installs the Node version
# named in that file (.github/actions/toolchain), and the first `npm ci`
# fails here if it does not satisfy the range — so the two cannot drift
# apart silently, without a bespoke version-comparing gate to do it.
engine-strict=true
